{
    "name": "AST2700A2_ROM_patch_v9",
    "version": "2700A2",
    "rom_region": {
	"file_name": "all_patches.bin",
        "w_offset": "0x0"
    },
    "config_region": {
	// OTPCFG0[5]
        // Enable static write protection of OTPROM region
        // Once it's enabled, no one can prog the OTPROM region anymore.
        "wr_protect_rom": true,
	// OTPCFG6[10: 1]
        // OTP patch code offset
        // The OTP patch code location in OTPROM Region.
        "OTP_Patch_Code_location_2": "0x0",
        // OTPCFG6[0]
        // Enable otp patch 2
        // 0: otp rom patch 2 is invalid
        // 1: otp rom patch 2 is valid
        "otp_patch_vld_2": true,
        // OTPCFG7[9: 0]
        // OTP Patch 2 code size (unit: word)
        // The Boot ROM can execute OTP patch codes in OTPROM region. The OTP patch code size is
        // limited of 16Kbit.
        "OTP_Patch_Size_2": "0x31a",
	// OTPCFG11[7]
        // Enable Write protect for OTP region user 3
        "wr_protect_otp_usr3": true,
	// OTPCFG11[5]
        // Enable Write protect for OTP region user 2
        "wr_protect_otp_usr2": true,
	// OTPCFG24[10: 1]
        // OTP patch code offset
        // The OTP patch code location in OTPROM Region.
        "OTP_Patch_Code_location_3": "0x320",
        // OTPCFG24[0]
        // Enable otp patch 3
        // 0: otp rom patch 3 is invalid
        // 1: otp rom patch 3 is valid
        "otp_patch_vld_3": true,
        // OTPCFG25[9: 0]
        // OTP Patch 3 code size (unit: word)
        // The Boot ROM can execute OTP patch codes in OTPROM region. The OTP patch code size is
        // limited of 16Kbit.
        "OTP_Patch_Size_3": "0xb1"
    },
    "user_region": {
        // OTPUSR 0x440 - 14336 bits
        // rom_patch_user.bin: 4232 bytes (33856 bits)
	"ROM_patch": ""
    }
}
